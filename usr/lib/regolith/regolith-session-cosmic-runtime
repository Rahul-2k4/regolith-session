#!/bin/bash
# Start the Sway compositor for the experimental COSMIC session and only then
# hand selected helper ownership to COSMIC-side processes.

set -Eeu -o pipefail

source "${REGOLITH_COSMIC_SESSION_HELPERS:-/usr/lib/regolith/regolith-session-cosmic.sh}"

target_started=false
compositor_pid=
legacy_gnome_target_mask_owned=false
legacy_wayland_target_mask_owned=false
legacy_powerd_mask_owned=false
cosmic_parent_termination_attempted=false

regolith_legacy_target_is_pre_masked() {
    local target="$1"
    local state=

    state="$(systemctl --user is-enabled "$target" 2>/dev/null || true)"

    case "$state" in
        masked|masked-runtime)
            return 0
            ;;
        enabled|enabled-runtime|linked|linked-runtime|disabled|static|indirect|generated|transient|alias)
            return 1
            ;;
        not-found|"")
            # The unit does not exist on this install at all (e.g. a
            # COSMIC-only install that never pulled in the GNOME-targets
            # package). That is not masked, so treat it the same as
            # "disabled": nothing to preserve, safe to mask for COSMIC.
            return 1
            ;;
    esac

    echo "regolith-session: failed to establish mask state for $target; skipping COSMIC helper startup" >&2
    return 2
}

unmask_regolith_legacy_targets_owned_by_cosmic() {
    if [ "$legacy_gnome_target_mask_owned" = true ]; then
        systemctl --user unmask regolith-gnome.target || true
        legacy_gnome_target_mask_owned=false
    fi

    if [ "$legacy_wayland_target_mask_owned" = true ]; then
        systemctl --user unmask regolith-wayland.target || true
        legacy_wayland_target_mask_owned=false
    fi

    if [ "$legacy_powerd_mask_owned" = true ]; then
        systemctl --user unmask regolith-init-powerd.service || true
        legacy_powerd_mask_owned=false
    fi
}

regolith_cosmic_runtime_stop_process_group() {
    local pid="$1"

    if [ -z "$pid" ]; then
        return 0
    fi

    kill -- "-$pid" >/dev/null 2>&1 || true
    wait "$pid" >/dev/null 2>&1 || true
}

regolith_cosmic_runtime_stop_owned_helpers() {
    local pid=

    for pid in $(jobs -pr); do
        if [ "$pid" != "${compositor_pid:-}" ]; then
            regolith_cosmic_runtime_stop_process_group "$pid"
        fi
    done
}

regolith_cosmic_runtime_parent_pid() {
    regolith_cosmic_runtime_parse_parent_pid "$1"
}

regolith_cosmic_runtime_parse_parent_pid() {
    local stat=
    local prefix=
    local fields=
    local state=
    local parent_pid=

    stat="$(cat "/proc/$1/stat" 2>/dev/null || true)"
    [ -n "$stat" ] || return 1

    prefix="${stat%)*}"
    [ "$prefix" != "$stat" ] || return 1
    fields="${stat:${#prefix}+1}"
    read -r state parent_pid _ <<<"$fields"
    [ -n "$state" ] || return 1
    case "$parent_pid" in
        ''|*[!0-9]*) return 1 ;;
    esac

    printf '%s\n' "$parent_pid"
}

regolith_cosmic_runtime_parent_executable() {
    local pid="$1"
    local executable=

    executable="$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)"
    [ -n "$executable" ] || return 1
    basename "$executable"
}

regolith_cosmic_runtime_parent_start_pid() {
    printf '%s\n' "${PPID:-1}"
}

regolith_cosmic_runtime_find_owned_parent() {
    local pid="$(regolith_cosmic_runtime_parent_start_pid)"
    local executable=

    while [ "$pid" -gt 1 ] 2>/dev/null; do
        executable="$(regolith_cosmic_runtime_parent_executable "$pid" || true)"
        case "$executable" in
            cosmic-session)
                printf '%s\n' "$pid"
                return 0
                ;;
        esac
        pid="$(regolith_cosmic_runtime_parent_pid "$pid" || true)"
        [ -n "$pid" ] || return 1
    done

    return 1
}

regolith_cosmic_runtime_terminate_owned_parent() {
    local parent_pid=

    if [ "$cosmic_parent_termination_attempted" = true ]; then
        return 0
    fi
    cosmic_parent_termination_attempted=true

    if [ "${REGOLITH_COSMIC_LAUNCHER_OWNED:-}" != 1 ]; then
        return 0
    fi

    parent_pid="$(regolith_cosmic_runtime_find_owned_parent || true)"
    if [ -n "$parent_pid" ]; then
        kill -TERM "$parent_pid" >/dev/null 2>&1 || true
    fi
}

regolith_cosmic_runtime_cleanup() {
    local force_target_stop="${1:-false}"

    if [ "$target_started" = true ] || [ "$force_target_stop" = true ]; then
        systemctl --user stop cosmic-session.target || true
        target_started=false
    fi

    regolith_cosmic_runtime_stop_compositor
    regolith_cosmic_runtime_stop_owned_helpers
    unmask_regolith_legacy_targets_owned_by_cosmic
    systemctl --user unset-environment XDG_CURRENT_DESKTOP WAYLAND_DISPLAY SWAYSOCK || true
    unset SWAYSOCK || true
    regolith_cosmic_runtime_terminate_owned_parent
}

mask_regolith_legacy_targets_for_cosmic() {
    local gnome_target_pre_masked=false
    local wayland_target_pre_masked=false
    local powerd_pre_masked=false
    local mask_state_status=0

    if regolith_legacy_target_is_pre_masked regolith-gnome.target; then
        gnome_target_pre_masked=true
    else
        mask_state_status=$?
        if [ "$mask_state_status" -ne 1 ]; then
            return 1
        fi
    fi

    if regolith_legacy_target_is_pre_masked regolith-wayland.target; then
        wayland_target_pre_masked=true
    else
        mask_state_status=$?
        if [ "$mask_state_status" -ne 1 ]; then
            return 1
        fi
    fi

    if regolith_legacy_target_is_pre_masked regolith-init-powerd.service; then
        powerd_pre_masked=true
    else
        mask_state_status=$?
        if [ "$mask_state_status" -ne 1 ]; then
            return 1
        fi
    fi

    if [ "$gnome_target_pre_masked" != true ]; then
        if ! systemctl --user mask --runtime regolith-gnome.target; then
            echo "regolith-session: failed to mask legacy Regolith targets; skipping COSMIC helper startup" >&2
            return 1
        fi
        legacy_gnome_target_mask_owned=true
    fi

    if [ "$wayland_target_pre_masked" != true ]; then
        if ! systemctl --user mask --runtime regolith-wayland.target; then
            echo "regolith-session: failed to mask legacy Regolith targets; skipping COSMIC helper startup" >&2
            unmask_regolith_legacy_targets_owned_by_cosmic
            return 1
        fi
        legacy_wayland_target_mask_owned=true
    fi

    if [ "$powerd_pre_masked" != true ]; then
        if ! systemctl --user mask --runtime regolith-init-powerd.service; then
            echo "regolith-session: failed to mask legacy powerd; skipping COSMIC helper startup" >&2
            unmask_regolith_legacy_targets_owned_by_cosmic
            return 1
        fi
        legacy_powerd_mask_owned=true
    fi

    if ! systemctl --user stop regolith-init-powerd.service; then
        echo "regolith-session: failed to stop legacy powerd; skipping COSMIC helper startup" >&2
        unmask_regolith_legacy_targets_owned_by_cosmic
        return 1
    fi

    systemctl --user stop regolith-gnome.target || true
    systemctl --user stop regolith-wayland.target || true
}

regolith_cosmic_runtime_stop_compositor() {
    if [ -n "${compositor_pid:-}" ] && kill -0 "$compositor_pid" >/dev/null 2>&1; then
        regolith_cosmic_runtime_stop_process_group "$compositor_pid"
    fi

    if [ -n "${compositor_pid:-}" ]; then
        wait "$compositor_pid" >/dev/null 2>&1 || true
    fi
}

regolith_cosmic_runtime_abort_session() {
    local status="$1"

    regolith_cosmic_runtime_cleanup true
    return "$status"
}

regolith_cosmic_runtime_on_exit() {
    local status=$?

    trap - EXIT INT TERM
    regolith_cosmic_runtime_cleanup
    exit "$status"
}

regolith_cosmic_runtime_main() {
    setsid -- "$@" &
    compositor_pid=$!

    if wait_for_regolith_cosmic_wayland_socket; then
        if wait_for_regolith_cosmic_sway_socket; then
            if kill -0 "$compositor_pid" >/dev/null 2>&1; then
                systemctl --user import-environment XDG_CURRENT_DESKTOP WAYLAND_DISPLAY SWAYSOCK

                if systemctl --user is-active --quiet cosmic-session.target; then
                    if ! systemctl --user start regolith-cosmic.target; then
                        echo "regolith-session: failed to reinitialize COSMIC helper target; aborting COSMIC session" >&2
                        regolith_cosmic_runtime_abort_session 1
                        return $?
                    fi
                    if ! mask_regolith_legacy_targets_for_cosmic; then
                        echo "regolith-session: failed to isolate legacy Regolith targets; aborting COSMIC session" >&2
                        regolith_cosmic_runtime_abort_session 1
                        return $?
                    fi
                    if ! start_regolith_cosmic_helpers; then
                        echo "regolith-session: failed to start COSMIC helpers; aborting session" >&2
                        regolith_cosmic_runtime_abort_session 1
                        return $?
                    fi
                else
                    target_state_status=$?

                    if [ "$target_state_status" -eq 3 ] && systemctl --user start cosmic-session.target; then
                        target_started=true

                        if kill -0 "$compositor_pid" >/dev/null 2>&1; then
                            if ! mask_regolith_legacy_targets_for_cosmic; then
                                echo "regolith-session: failed to isolate legacy Regolith targets; aborting COSMIC session" >&2
                                regolith_cosmic_runtime_abort_session 1
                                return $?
                            fi
                            if ! start_regolith_cosmic_helpers; then
                                echo "regolith-session: failed to start COSMIC helpers; aborting session" >&2
                                regolith_cosmic_runtime_abort_session 1
                                return $?
                            fi
                        else
                            echo "regolith-session: compositor exited after COSMIC target startup; stopping target and skipping helpers" >&2
                            systemctl --user stop cosmic-session.target || true
                            target_started=false
                        fi
                    else
                        if [ "$target_state_status" -eq 3 ]; then
                            echo "regolith-session: failed to start cosmic-session.target; skipping COSMIC helper startup" >&2
                        else
                            echo "regolith-session: failed to query cosmic-session.target state; skipping COSMIC helper startup" >&2
                        fi
                    fi
                fi
            else
                echo "regolith-session: compositor exited before COSMIC readiness; skipping target startup" >&2
            fi
        else
            echo "regolith-session: Sway IPC socket was not found; skipping COSMIC helper startup" >&2
        fi
    fi

    set +e
    wait "$compositor_pid"
    compositor_status=$?
    set -e

    regolith_cosmic_runtime_cleanup

    return "$compositor_status"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    trap regolith_cosmic_runtime_on_exit EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    regolith_cosmic_runtime_main "$@"
    exit $?
fi

#!/bin/bash
# Start the Sway compositor for the experimental COSMIC session and only then
# hand selected helper ownership to COSMIC-side processes.

set -Eeu -o pipefail

source /usr/lib/regolith/regolith-session-cosmic.sh

"$@" &
compositor_pid=$!
target_started=false
legacy_targets_masked=false

mask_regolith_legacy_targets_for_cosmic() {
    if systemctl --user mask --runtime regolith-gnome.target regolith-wayland.target; then
        legacy_targets_masked=true
        systemctl --user stop regolith-gnome.target || true
        systemctl --user stop regolith-wayland.target || true
    else
        echo "regolith-session: failed to mask legacy Regolith targets; skipping legacy target stop" >&2
    fi
}

if wait_for_regolith_cosmic_wayland_socket; then
    if wait_for_regolith_cosmic_sway_socket; then
        if kill -0 "$compositor_pid" >/dev/null 2>&1; then
            if systemctl --user is-active --quiet cosmic-session.target; then
                mask_regolith_legacy_targets_for_cosmic
                start_regolith_cosmic_helpers
            else
                target_state_status=$?

                if [ "$target_state_status" -eq 3 ] && systemctl --user start cosmic-session.target; then
                    target_started=true

                    if kill -0 "$compositor_pid" >/dev/null 2>&1; then
                        mask_regolith_legacy_targets_for_cosmic
                        start_regolith_cosmic_helpers
                    else
                        echo "regolith-session: compositor exited after COSMIC target startup; stopping target and skipping helpers" >&2
                        systemctl --user stop cosmic-session.target || true
                        target_started=false
                    fi
                else
                    if [ "$target_state_status" -eq 3 ]; then
                        echo "regolith-session: failed to start cosmic-session.target; skipping COSMIC helper startup" >&2
                    else
                        echo "regolith-session: failed to query cosmic-session.target state; skipping COSMIC helper startup" >&2
                    fi
                fi
            fi
        else
            echo "regolith-session: compositor exited before COSMIC readiness; skipping target startup" >&2
        fi
    else
        echo "regolith-session: Sway IPC socket was not found; skipping COSMIC helper startup" >&2
    fi
fi

set +e
wait "$compositor_pid"
compositor_status=$?
set -e

if [ "$target_started" = true ]; then
    systemctl --user stop cosmic-session.target || true
fi

if [ "$legacy_targets_masked" = true ]; then
    systemctl --user unmask regolith-gnome.target regolith-wayland.target || true
fi

exit "$compositor_status"
